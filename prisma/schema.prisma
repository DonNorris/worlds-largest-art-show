generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ARTIST
  ADMIN
}

enum Plan {
  FREE
  FEATURED
  PREMIUM
}

enum ShowStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ARTIST)
  createdAt DateTime @default(now())
}

model Show {
  id          String     @id @default(cuid())
  showName    String
  artistName  String
  email       String?
  county      String
  state       String
  town        String
  mainMedium  String?
  startDate   String?
  endDate     String?
  showHours   String?
  description String?
  website     String?
  instagram   String?
  facebook      String?
  tiktok        String?
  xTwitter      String?
  onlineStore   String?
  videoLink     String?
  galleryStudioLink String?
  contactEmail      String?
  mailingListLink   String?
  photoUrl          String?
  photoUrl2 String?
photoUrl3 String?
photoUrl4 String?
photoUrl5 String?
artistPhotoUrl String?
bio           String?
classes       String?
services      String?
commissions   String?
upcomingShows String?
  plan        Plan
  upgradePackage String @default("FREE")
  paymentStatus String @default("FREE")
  status      ShowStatus @default(DRAFT)
  userId      String?
  createdAt   DateTime   @default(now())
}