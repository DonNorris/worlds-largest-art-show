generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ARTIST
  ADMIN
}

enum Plan {
  FREE
  FEATURED
  PREMIUM
}

enum ShowStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ARTIST)
  createdAt DateTime @default(now())
}

model Show {
  id         String     @id @default(cuid())
  showName   String
  artistName String
  county     String
  state      String
  town       String
  plan       Plan
  status     ShowStatus @default(DRAFT)
  userId     String?
  createdAt  DateTime   @default(now())
}